<UserControl x:Class="GanttIt.Revit.UI.Editor.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:GanttIt.Revit.UI.Mvvm"
             xmlns:editor="clr-namespace:GanttIt.Revit.UI.Editor"
             xmlns:preview="clr-namespace:GanttIt.Revit.UI.Preview"
             AutomationProperties.AutomationId="EditorView">
    <!-- Chart editor (§2.2). DataContext: EditorViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GanttIt.Revit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Column widths shared by the grid header and every row. Name takes the rest. -->
            <GridLength x:Key="HandleCol">22</GridLength>
            <GridLength x:Key="NumberCol">26</GridLength>
            <GridLength x:Key="DateCol">128</GridLength>
            <GridLength x:Key="DaysCol">62</GridLength>
            <GridLength x:Key="LinkCol">72</GridLength>
            <GridLength x:Key="ColorCol">54</GridLength>
            <GridLength x:Key="DeleteCol">34</GridLength>

            <Style x:Key="RowBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="0,3" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DropMarker}" Value="Above">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentForegroundBrush}" />
                        <Setter Property="BorderThickness" Value="0,2,0,1" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DropMarker}" Value="Below">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentForegroundBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasError}" Value="True">
                        <Setter Property="Background" Value="{StaticResource ErrorRowBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SwatchButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chip" Width="34" Height="20" CornerRadius="3"
                                    Background="{TemplateBinding Background}" BorderBrush="{StaticResource ChipBorderBrush}" BorderThickness="1" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource ChipHoverBorderBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />            <!-- 0 header -->
            <RowDefinition Height="Auto" />            <!-- 1 chart properties -->
            <RowDefinition Height="Auto" />            <!-- 2 notices -->
            <RowDefinition Height="*" MinHeight="140" /> <!-- 3 sections -->
            <RowDefinition Height="Auto" />            <!-- 4 splitter -->
            <RowDefinition Height="230" MinHeight="110" /> <!-- 5 preview -->
            <RowDefinition Height="Auto" />            <!-- 6 issues + buttons -->
        </Grid.RowDefinitions>

        <!-- 0 Header -->
        <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Command="{Binding SettingsCommand}"
                    AutomationProperties.AutomationId="Editor.Settings" AutomationProperties.Name="Settings"
                    ToolTip="Project settings: styles, date format, padding">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="Settings" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource HeadingText}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="Editor.Heading" />
        </DockPanel>

        <!-- 1 Chart properties -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Name" Style="{StaticResource LabelText}" />
                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         mvvm:Behaviors.HasError="{Binding HasNameError}" ToolTip="{Binding NameError}"
                         AutomationProperties.AutomationId="Editor.ChartName" AutomationProperties.Name="Chart name" />

                <TextBlock Grid.Column="2" Text="Title" Style="{StaticResource LabelText}" Margin="16,0,8,0" />
                <TextBox Grid.Column="3" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Drawn above the chart. Follows the name until you change it; blank means no title."
                         AutomationProperties.AutomationId="Editor.ChartTitle" AutomationProperties.Name="Chart title" />

                <TextBlock Grid.Column="4" Text="Timescale" Style="{StaticResource LabelText}" Margin="16,0,8,0" />
                <ComboBox Grid.Column="5" ItemsSource="{Binding TimescaleOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding Timescale}"
                          AutomationProperties.AutomationId="Editor.Timescale" AutomationProperties.Name="Timescale" />

                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding NameError}"
                           Style="{StaticResource ErrorText}" FontSize="11" Margin="0,3,0,0"
                           Visibility="{Binding NameError, Converter={StaticResource NullToCollapsed}}"
                           AutomationProperties.AutomationId="Editor.ChartNameError" />

                <TextBlock Grid.Row="2" Text="Columns" Style="{StaticResource LabelText}" Margin="0,10,8,0" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Section (always)" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox Content="Start" IsChecked="{Binding ShowStart}" Margin="0,0,12,0"
                              AutomationProperties.AutomationId="Editor.ShowStart" />
                    <CheckBox Content="End" IsChecked="{Binding ShowEnd}" Margin="0,0,12,0"
                              AutomationProperties.AutomationId="Editor.ShowEnd" />
                    <CheckBox Content="Duration" IsChecked="{Binding ShowDuration}"
                              AutomationProperties.AutomationId="Editor.ShowDuration" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="16,10,0,0"
                            HorizontalAlignment="Right">
                    <TextBlock Text="Timeline width" Style="{StaticResource LabelText}" />
                    <TextBox Width="110" Text="{Binding TimelineWidth.Text, UpdateSourceTrigger=LostFocus}"
                             mvvm:Behaviors.CommitOnEnter="True"
                             mvvm:Behaviors.HasError="{Binding TimelineWidth.HasError}"
                             ToolTip="Width of the timeline on paper, in project units"
                             AutomationProperties.AutomationId="Editor.TimelineWidth" AutomationProperties.Name="Timeline width" />
                    <TextBlock Text="Name column max" Style="{StaticResource LabelText}" Margin="16,0,8,0" />
                    <TextBox Width="110" Text="{Binding NameMaxWidth.Text, UpdateSourceTrigger=LostFocus}"
                             mvvm:Behaviors.CommitOnEnter="True"
                             mvvm:Behaviors.HasError="{Binding NameMaxWidth.HasError}"
                             ToolTip="Longest the section name column gets on paper, in project units; longer names wrap"
                             AutomationProperties.AutomationId="Editor.NameMaxWidth"
                             AutomationProperties.Name="Name column maximum width" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2 Inline notices -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Notices}" Focusable="False"
                      AutomationProperties.AutomationId="Editor.Notices">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type editor:NoticeViewModel}">
                    <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" VerticalAlignment="Center"
                                    Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.AutomationId="Editor.Notice.Dismiss" AutomationProperties.Name="Dismiss">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                            </Button>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="{Binding AutomationId}" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 3 Sections grid -->
        <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="0">
            <DockPanel>
                <!-- Column headers. The trailing column matches the rows' scroll bar. -->
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        Background="{StaticResource SurfaceAltBrush}" Padding="8,6,0,6" CornerRadius="4,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource HandleCol}" />
                            <ColumnDefinition Width="{StaticResource NumberCol}" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="{StaticResource DateCol}" />
                            <ColumnDefinition Width="{StaticResource DateCol}" />
                            <ColumnDefinition Width="{StaticResource DaysCol}" />
                            <ColumnDefinition Width="{StaticResource LinkCol}" />
                            <ColumnDefinition Width="{StaticResource LinkCol}" />
                            <ColumnDefinition Width="{StaticResource ColorCol}" />
                            <ColumnDefinition Width="{StaticResource DeleteCol}" />
                            <ColumnDefinition Width="{Binding Source={x:Static SystemParameters.VerticalScrollBarWidth}, Converter={StaticResource DoubleToGridLength}}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="#" Style="{StaticResource ColumnHeaderText}" />
                        <TextBlock Grid.Column="2" Text="Name" Style="{StaticResource ColumnHeaderText}" Margin="4,0,0,0" />
                        <TextBlock Grid.Column="3" Text="Start" Style="{StaticResource ColumnHeaderText}" Margin="6,0,0,0" />
                        <TextBlock Grid.Column="4" Text="End" Style="{StaticResource ColumnHeaderText}" Margin="6,0,0,0" />
                        <TextBlock Grid.Column="5" Text="Days" Style="{StaticResource ColumnHeaderText}" Margin="6,0,0,0" />
                        <TextBlock Grid.Column="6" Text="Relates to previous" Style="{StaticResource ColumnHeaderText}"
                                   TextAlignment="Center" />
                        <TextBlock Grid.Column="7" Text="Relates to following" Style="{StaticResource ColumnHeaderText}"
                                   TextAlignment="Center" />
                        <TextBlock Grid.Column="8" Text="Color" Style="{StaticResource ColumnHeaderText}" TextAlignment="Center" />
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="8,6">
                    <Button Content="+  Add section" HorizontalAlignment="Left" Command="{Binding AddSectionCommand}"
                            AutomationProperties.AutomationId="Editor.AddSection" AutomationProperties.Name="Add section" />
                </Border>

                <!-- Virtualized (Beyond Intention: hundreds of sections). The ItemsControl hosts its own
                     ScrollViewer so the VirtualizingStackPanel can realize only the visible rows. -->
                <ItemsControl x:Name="SectionsList" ItemsSource="{Binding Rows}" Focusable="False" AllowDrop="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                              AutomationProperties.AutomationId="Editor.Sections" AutomationProperties.Name="Sections">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer x:Name="PART_Scroller" Focusable="False" CanContentScroll="True"
                                              VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type editor:SectionRowViewModel}">
                                <Border Style="{StaticResource RowBorder}" AllowDrop="True" ToolTip="{Binding Error}"
                                        ToolTipService.IsEnabled="{Binding HasError}"
                                        DragOver="OnRowDragOver" DragLeave="OnRowDragLeave" Drop="OnRowDrop">
                                    <Grid Margin="8,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource HandleCol}" />
                                            <ColumnDefinition Width="{StaticResource NumberCol}" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="{StaticResource DateCol}" />
                                            <ColumnDefinition Width="{StaticResource DateCol}" />
                                            <ColumnDefinition Width="{StaticResource DaysCol}" />
                                            <ColumnDefinition Width="{StaticResource LinkCol}" />
                                            <ColumnDefinition Width="{StaticResource LinkCol}" />
                                            <ColumnDefinition Width="{StaticResource ColorCol}" />
                                            <ColumnDefinition Width="{StaticResource DeleteCol}" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Drag handle (also Alt+Up / Alt+Down when focused) -->
                                        <Border Background="Transparent" Cursor="SizeNS" Focusable="True"
                                                FocusVisualStyle="{StaticResource FocusRing}"
                                                ToolTip="Drag to reorder (or Alt+Up / Alt+Down)"
                                                PreviewMouseLeftButtonDown="OnHandleMouseDown" MouseMove="OnHandleMouseMove"
                                                KeyDown="OnHandleKeyDown"
                                                AutomationProperties.AutomationId="{Binding Number, StringFormat='Section{0}.DragHandle'}"
                                                AutomationProperties.Name="Reorder">
                                            <TextBlock Text="&#xE76F;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding Number}" Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center" />

                                        <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,6,0"
                                                 mvvm:Behaviors.HasError="{Binding HasNameError}"
                                                 AutomationProperties.AutomationId="{Binding Number, StringFormat='Section{0}.Name'}"
                                                 AutomationProperties.Name="Section name" />

                                        <!-- Dates in the chart's date format (Settings), typed or from the calendar -->
                                        <editor:DateField Grid.Column="3" SelectedDate="{Binding StartDate}" Margin="0,0,6,0"
                                                          PendingText="{Binding StartPendingText}"
                                                          DateFormat="{Binding DateFormat}"
                                                          DisplayDateStart="{x:Static editor:EditorDates.Min}"
                                                          DisplayDateEnd="{x:Static editor:EditorDates.Max}"
                                                          HasError="{Binding HasDateError}"
                                                          FieldId="{Binding Number, StringFormat='Section{0}.Start'}"
                                                          FieldName="Start" />

                                        <editor:DateField Grid.Column="4" SelectedDate="{Binding EndDate}" Margin="0,0,6,0"
                                                          PendingText="{Binding EndPendingText}"
                                                          DateFormat="{Binding DateFormat}"
                                                          DisplayDateStart="{x:Static editor:EditorDates.Min}"
                                                          DisplayDateEnd="{x:Static editor:EditorDates.Max}"
                                                          HasError="{Binding HasDateError}"
                                                          FieldId="{Binding Number, StringFormat='Section{0}.End'}"
                                                          FieldName="End" />

                                        <TextBox Grid.Column="5" Text="{Binding DurationText, UpdateSourceTrigger=LostFocus}"
                                                 Margin="0,0,6,0" HorizontalContentAlignment="Right"
                                                 mvvm:Behaviors.CommitOnEnter="True"
                                                 AutomationProperties.AutomationId="{Binding Number, StringFormat='Section{0}.Duration'}"
                                                 AutomationProperties.Name="Duration in days" />

                                        <CheckBox Grid.Column="6" IsChecked="{Binding LinkPrevious}" HorizontalAlignment="Center"
                                                  IsEnabled="{Binding IsFirst, Converter={StaticResource InverseBool}}"
                                                  ToolTip="Relates to previous: keeps this section's gap after the previous one"
                                                  AutomationProperties.AutomationId="{Binding Number, StringFormat='Section{0}.LinkPrevious'}"
                                                  AutomationProperties.Name="Relates to previous" />

                                        <CheckBox Grid.Column="7" IsChecked="{Binding LinkFollowing}" HorizontalAlignment="Center"
                                                  IsEnabled="{Binding IsLast, Converter={StaticResource InverseBool}}"
                                                  ToolTip="Relates to following: keeps the next section's gap after this one"
                                                  AutomationProperties.AutomationId="{Binding Number, StringFormat='Section{0}.LinkFollowing'}"
                                                  AutomationProperties.Name="Relates to following" />

                                        <Button Grid.Column="8" Style="{StaticResource SwatchButton}" Background="{Binding ColorBrush}"
                                                HorizontalAlignment="Center" Command="{Binding PickColorCommand}"
                                                ToolTip="{Binding ColorHex}"
                                                AutomationProperties.AutomationId="{Binding Number, StringFormat='Section{0}.Color'}"
                                                AutomationProperties.Name="{Binding ColorHex, StringFormat='Color {0}'}" />

                                        <Button Grid.Column="9" Style="{StaticResource IconButton}" Command="{Binding RemoveCommand}"
                                                HorizontalAlignment="Center" ToolTip="Delete section"
                                                AutomationProperties.AutomationId="{Binding Number, StringFormat='Section{0}.Delete'}"
                                                AutomationProperties.Name="Delete section">
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- 4 Splitter: drag to give the preview more room -->
        <GridSplitter Grid.Row="4" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" Focusable="False"
                      ToolTip="Drag to resize the preview" />

        <!-- 5 Live preview (§2.2, §6) -->
        <Border Grid.Row="5" Style="{StaticResource Panel}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,6,10,0">
                    <TextBlock Text="Preview" Style="{StaticResource SectionText}" Margin="0" />
                    <TextBlock Text="{Binding Preview.Note}" Style="{StaticResource MutedText}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                               ToolTip="{Binding Preview.Note}"
                               AutomationProperties.AutomationId="Editor.PreviewNote" />
                </DockPanel>
                <Grid>
                    <preview:PreviewCanvas Layout="{Binding Preview.Layout}" Metrics="{Binding Preview.Metrics}"
                                           AutomationProperties.AutomationId="Editor.Preview"
                                           AutomationProperties.Name="Chart preview" />
                    <TextBlock Text="{Binding Preview.Message}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                               Visibility="{Binding Preview.Message, Converter={StaticResource NullToCollapsed}}"
                               AutomationProperties.AutomationId="Editor.PreviewMessage" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- 6 Validation + buttons -->
        <DockPanel Grid.Row="6" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Delete chart" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"
                        Visibility="{Binding IsExisting, Converter={StaticResource BoolToVisible}}" Margin="0,0,24,0"
                        AutomationProperties.AutomationId="Editor.Delete" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="88"
                        ToolTip="Discard changes and go back"
                        AutomationProperties.AutomationId="Editor.Cancel" />
                <Button Content="{Binding GenerateText}" Command="{Binding GenerateCommand}" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        AutomationProperties.AutomationId="Editor.Generate"
                        AutomationProperties.Name="{Binding GenerateText}" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="{Binding IssueSummary}" AutomationProperties.AutomationId="Editor.IssueSummary">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ScrollViewer MaxHeight="52" VerticalScrollBarVisibility="Auto" Focusable="False"
                              Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisible}}">
                    <ItemsControl ItemsSource="{Binding Issues}" Focusable="False"
                                  AutomationProperties.AutomationId="Editor.Issues" AutomationProperties.Name="Problems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='•  {0}'}" Style="{StaticResource ErrorText}"
                                           AutomationProperties.Name="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
