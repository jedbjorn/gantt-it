<UserControl x:Class="GanttIt.Revit.UI.Editor.DateField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GanttIt.Revit.UI.Localization"
             Focusable="False">
    <!--
        A date field that shows and reads dates in the project's date format (Settings),
        with the standard WPF calendar as its drop-down. WPF's DatePicker always formats
        and parses with the machine's culture, so it can't follow a chart's pattern.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GanttIt.Revit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox x:Name="Box" Grid.ColumnSpan="2" Padding="4,2,28,2" />

        <Button x:Name="CalendarButton" Grid.Column="1" Style="{StaticResource IconButton}"
                Padding="4,0" MinHeight="22" MinWidth="24" Margin="0,2,2,2" Focusable="False"
                ToolTip="{l:Tr Date_CalendarTip}" AutomationProperties.Name="{l:Tr Date_Calendar}">
            <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="13" />
        </Button>

        <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" Focusable="False">
            <Calendar x:Name="Picker" Margin="0,2,0,0" />
        </Popup>
    </Grid>
</UserControl>
