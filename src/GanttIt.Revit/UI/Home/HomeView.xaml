<UserControl x:Class="GanttIt.Revit.UI.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:home="clr-namespace:GanttIt.Revit.UI.Home"
             xmlns:preview="clr-namespace:GanttIt.Revit.UI.Preview"
             AutomationProperties.AutomationId="HomeView">
    <!-- Home (§2.1). DataContext: HomeViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GanttIt.Revit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Width" Value="264" />
                <Setter Property="Height" Value="268" />
                <Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <!-- New chart: the whole card is one button. -->
            <DataTemplate DataType="{x:Type home:NewChartCardViewModel}">
                <Button Command="{Binding NewChartCommand}" Width="264" Height="268" Margin="0,0,12,12"
                        Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                        AutomationProperties.AutomationId="Home.NewChart" AutomationProperties.Name="New chart">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="28"
                                   Foreground="{StaticResource AccentForegroundBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="New chart" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Creates a legend view" Style="{StaticResource MutedText}" Margin="0,2,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DataTemplate>

            <!-- One chart. -->
            <DataTemplate DataType="{x:Type home:ChartCardViewModel}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="124" Margin="8,8,8,0" CornerRadius="3"
                                Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1">
                            <Grid>
                                <preview:PreviewCanvas Layout="{Binding Thumbnail}" Metrics="{Binding Metrics}"
                                                       IsThumbnail="True" Inset="6"
                                                       AutomationProperties.AutomationId="Home.ChartCard.Thumbnail"
                                                       AutomationProperties.Name="{Binding Name, StringFormat='Thumbnail of {0}'}" />
                                <TextBlock Text="No preview" Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToCollapsed}}" />
                            </Grid>
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,0,8,8">
                            <Button Content="Edit" Command="{Binding EditCommand}" MinWidth="64"
                                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisible}}"
                                    AutomationProperties.AutomationId="Home.ChartCard.Edit"
                                    AutomationProperties.Name="{Binding EditName}" />
                            <Button Content="Open view" Command="{Binding OpenViewCommand}" Margin="6,0,0,0"
                                    AutomationProperties.AutomationId="Home.ChartCard.OpenView"
                                    AutomationProperties.Name="{Binding OpenViewName}"
                                    ToolTip="Closes Gantt-It and opens this legend" />
                            <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="6,0,0,0"
                                    Style="{StaticResource DangerButton}"
                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisible}}"
                                    AutomationProperties.AutomationId="Home.ChartCard.Delete"
                                    AutomationProperties.Name="{Binding DeleteName}" />
                        </StackPanel>

                        <StackPanel Margin="10,8,10,6">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}" AutomationProperties.AutomationId="Home.ChartCard.Name" />
                            <TextBlock Text="{Binding SpanText}" Style="{StaticResource MutedText}" Margin="0,3,0,0"
                                       AutomationProperties.AutomationId="Home.ChartCard.Span" />
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <TextBlock Text="{Binding SectionsText}" Style="{StaticResource MutedText}"
                                           AutomationProperties.AutomationId="Home.ChartCard.Sections" />
                                <TextBlock Text="  ·  " Style="{StaticResource MutedText}"
                                           Visibility="{Binding SectionsText, Converter={StaticResource NullToCollapsed}}" />
                                <TextBlock Text="{Binding PlacementText}" Style="{StaticResource MutedText}"
                                           ToolTip="{Binding SheetsToolTip}"
                                           AutomationProperties.AutomationId="Home.ChartCard.Placement" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       MaxHeight="30" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"
                                       Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}"
                                       AutomationProperties.AutomationId="Home.ChartCard.Status">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="20,16,20,8">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Command="{Binding SettingsCommand}" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Home.Settings" AutomationProperties.Name="Settings"
                    ToolTip="Project settings: styles, date format, padding">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="Settings" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Gantt charts" Style="{StaticResource HeadingText}" />
                <TextBlock Text="Each chart is a legend view you can place on any number of sheets."
                           Style="{StaticResource MutedText}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Banners -->
        <StackPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,8"
                    Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="Home.Status" />
            </Border>
            <Border Style="{StaticResource ErrorBanner}" Margin="0,0,0,8"
                    Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" AutomationProperties.AutomationId="Home.Error" />
            </Border>
            <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,8"
                    Visibility="{Binding SettingsWarning, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding SettingsWarning}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="Home.SettingsWarning" />
            </Border>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="No charts in this model yet." Style="{StaticResource MutedText}"
                   Margin="0,4,0,0" Visibility="{Binding HasCharts, Converter={StaticResource BoolToCollapsed}}"
                   AutomationProperties.AutomationId="Home.Empty" />

        <!-- Cards: a ListBox so each card is a UI Automation list item named after its chart. -->
        <ListBox ItemsSource="{Binding Cards}" BorderThickness="0" Background="Transparent" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Continue"
                 AutomationProperties.AutomationId="Home.ChartList" AutomationProperties.Name="Charts">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</UserControl>
