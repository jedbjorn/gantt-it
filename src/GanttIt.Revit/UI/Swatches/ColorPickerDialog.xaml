<Window x:Class="GanttIt.Revit.UI.Swatches.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:swatches="clr-namespace:GanttIt.Revit.UI.Swatches"
        xmlns:l="clr-namespace:GanttIt.Revit.UI.Localization"
        Title="{l:Tr Color_DialogTitle}"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="ToolWindow" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="ColorPickerDialog">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GanttIt.Revit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="12">
        <swatches:ColorPicker />
        <Button Content="{l:Tr Common_Cancel}" IsCancel="True" HorizontalAlignment="Right" Margin="0,4,0,0" MinWidth="80"
                AutomationProperties.AutomationId="ColorPicker.Cancel" />
    </StackPanel>
</Window>
