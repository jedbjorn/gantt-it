<UserControl x:Class="GanttIt.Revit.UI.Swatches.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:GanttIt.Revit.UI.Mvvm"
             xmlns:l="clr-namespace:GanttIt.Revit.UI.Localization"
             AutomationProperties.AutomationId="ColorPicker">
    <!-- The custom color picker (§2.4). DataContext: ColorPickerViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GanttIt.Revit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SwatchButton" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chip" CornerRadius="3" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource ChipBorderBrush}" BorderThickness="1" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource ChipHoverBorderBrush}" />
                                    <Setter TargetName="Chip" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="SwatchTemplate">
                <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}"
                        Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" ToolTip="{Binding Hex}"
                        AutomationProperties.AutomationId="{Binding AutomationId}"
                        AutomationProperties.Name="{Binding Hex}" />
            </DataTemplate>

            <ItemsPanelTemplate x:Key="SwatchPanel">
                <WrapPanel Width="192" />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{l:Tr Color_Palette}" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding Palette}" ItemTemplate="{StaticResource SwatchTemplate}"
                      ItemsPanel="{StaticResource SwatchPanel}" Focusable="False"
                      AutomationProperties.AutomationId="ColorPicker.Palette" />

        <StackPanel Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="{l:Tr Color_Recent}" Style="{StaticResource LabelText}" Margin="0,4,0,4" />
            <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource SwatchTemplate}"
                          ItemsPanel="{StaticResource SwatchPanel}" Focusable="False"
                          AutomationProperties.AutomationId="ColorPicker.RecentColors" />
        </StackPanel>

        <TextBlock Text="{l:Tr Color_Hex}" Style="{StaticResource LabelText}" Margin="0,4,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="26" Height="26" CornerRadius="3" BorderBrush="{StaticResource ChipBorderBrush}" BorderThickness="1"
                    Background="{Binding CurrentBrush}" Margin="0,0,6,0" ToolTip="{l:Tr Color_CurrentTip}" />
            <!-- MinWidth keeps room for #RRGGBB when Apply is a longer word (Übernehmen, Appliquer). -->
            <TextBox Grid.Column="1" Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}" MinWidth="68"
                     mvvm:Behaviors.HasError="{Binding HasHexError}"
                     FontFamily="Consolas" MaxLength="7"
                     AutomationProperties.AutomationId="ColorPicker.Hex" AutomationProperties.Name="{l:Tr Color_HexName}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ApplyHexCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="2" Content="{l:Tr Color_Apply}" Margin="6,0,0,0" Command="{Binding ApplyHexCommand}"
                    AutomationProperties.AutomationId="ColorPicker.ApplyHex" />
            <!-- Eyedropper: any color visible on screen, e.g. one already used on the plans -->
            <Button Grid.Column="3" Margin="6,0,0,0" Padding="6,2" Command="{Binding PickFromScreenCommand}"
                    Visibility="{Binding CanPickFromScreen, Converter={StaticResource BoolToVisible}}"
                    ToolTip="{l:Tr Color_PickTip}"
                    AutomationProperties.AutomationId="ColorPicker.PickFromScreen" AutomationProperties.Name="{l:Tr Color_PickName}">
                <TextBlock Text="&#xEF3C;" FontFamily="{StaticResource IconFont}" FontSize="14" />
            </Button>
        </Grid>
        <TextBlock Text="{Binding HexError}" Style="{StaticResource ErrorText}" Margin="0,4,0,0" MaxWidth="192"
                   HorizontalAlignment="Left"
                   Visibility="{Binding HexError, Converter={StaticResource NullToCollapsed}}"
                   AutomationProperties.AutomationId="ColorPicker.HexError" />

        <Button Content="{l:Tr Color_More}" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding MoreCommand}"
                AutomationProperties.AutomationId="ColorPicker.More" AutomationProperties.Name="{l:Tr Color_MoreName}" />
    </StackPanel>
</UserControl>
