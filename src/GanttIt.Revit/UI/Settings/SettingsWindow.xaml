<Window x:Class="GanttIt.Revit.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mvvm="clr-namespace:GanttIt.Revit.UI.Mvvm"
        xmlns:settings="clr-namespace:GanttIt.Revit.UI.Settings"
        xmlns:l="clr-namespace:GanttIt.Revit.UI.Localization"
        Title="{l:Tr Settings_WindowTitle}"
        Width="620" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="SettingsWindow">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GanttIt.Revit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- One style row: label, picker, red hint while unset or missing. -->
            <DataTemplate x:Key="StylePickerRow" DataType="{x:Type settings:StylePickerViewModel}">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <!-- Labels share one width (the longest in the UI language, at least 150). -->
                        <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="SettingsLabel" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource LabelText}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                              DisplayMemberPath="Name"
                              mvvm:Behaviors.HasError="{Binding IsMissing}"
                              AutomationProperties.AutomationId="{Binding AutomationId}"
                              AutomationProperties.Name="{Binding Label}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hint}" Margin="0,3,0,0" FontSize="11"
                               TextWrapping="Wrap"
                               Visibility="{Binding Hint, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="{l:Tr Settings_Heading}" Style="{StaticResource HeadingText}" />
        <TextBlock Text="{l:Tr Settings_Subheading}"
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,12" />

        <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,10"
                Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVisible}}"
                AutomationProperties.AutomationId="Settings.FirstRunNotice">
            <TextBlock TextWrapping="Wrap"
                       Text="{l:Tr Settings_FirstRun}" />
        </Border>
        <Border Style="{StaticResource ErrorBanner}" Margin="0,0,0,10"
                Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding LoadError}" Style="{StaticResource ErrorText}"
                       AutomationProperties.AutomationId="Settings.LoadError" />
        </Border>
        <Border Style="{StaticResource ErrorBanner}" Margin="0,0,0,10"
                Visibility="{Binding MissingSummary, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding MissingSummary}" Style="{StaticResource ErrorText}"
                       AutomationProperties.AutomationId="Settings.MissingStyles" />
        </Border>

        <Border Style="{StaticResource Panel}" IsEnabled="{Binding IsEditable}">
            <StackPanel Grid.IsSharedSizeScope="True">
                <TextBlock Text="{l:Tr Settings_TextStyles}" Style="{StaticResource SectionText}" />
                <ContentControl Content="{Binding TitleText}" ContentTemplate="{StaticResource StylePickerRow}" Focusable="False" />
                <ContentControl Content="{Binding HeaderText}" ContentTemplate="{StaticResource StylePickerRow}" Focusable="False" />
                <ContentControl Content="{Binding BodyText}" ContentTemplate="{StaticResource StylePickerRow}" Focusable="False" />

                <TextBlock Text="{l:Tr Settings_LineStyles}" Style="{StaticResource SectionText}" Margin="0,6,0,6" />
                <ContentControl Content="{Binding ChartLine}" ContentTemplate="{StaticResource StylePickerRow}" Focusable="False" />
                <ContentControl Content="{Binding HeaderLine}" ContentTemplate="{StaticResource StylePickerRow}" Focusable="False" />

                <TextBlock Text="{l:Tr Settings_Format}" Style="{StaticResource SectionText}" Margin="0,6,0,6" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="SettingsLabel" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:Tr Settings_ChartLanguage}" Style="{StaticResource LabelText}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ChartLanguageOptions}"
                              SelectedItem="{Binding ChartLanguage}" DisplayMemberPath="Label"
                              AutomationProperties.AutomationId="Settings.ChartLanguage"
                              AutomationProperties.Name="{l:Tr Settings_ChartLanguage}"
                              ToolTip="{l:Tr Settings_ChartLanguageHint}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{l:Tr Settings_ChartLanguageHint}" Margin="0,3,0,0"
                               Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="SettingsLabel" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:Tr Settings_DateFormat}" Style="{StaticResource LabelText}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DateFormatOptions}"
                              SelectedItem="{Binding DateFormatOption}" DisplayMemberPath="Label"
                              AutomationProperties.AutomationId="Settings.DateFormat"
                              AutomationProperties.Name="{l:Tr Settings_DateFormat}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                             Text="{Binding CustomPattern, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsCustomDateFormat, Converter={StaticResource BoolToVisible}}"
                             mvvm:Behaviors.HasError="{Binding HasDateFormatError}"
                             FontFamily="Consolas"
                             AutomationProperties.AutomationId="Settings.CustomDateFormat"
                             AutomationProperties.Name="{l:Tr Settings_CustomPatternName}"
                             ToolTip="{l:Tr Settings_CustomPatternTip}" />
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,3,0,0">
                        <TextBlock Text="{Binding DateFormatSample}" Style="{StaticResource MutedText}" FontSize="11"
                                   AutomationProperties.AutomationId="Settings.DateFormatSample" />
                        <TextBlock Text="{Binding DateFormatError}" Style="{StaticResource ErrorText}" FontSize="11"
                                   Visibility="{Binding DateFormatError, Converter={StaticResource NullToCollapsed}}"
                                   AutomationProperties.AutomationId="Settings.DateFormatError" />
                    </Grid>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="SettingsLabel" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:Tr Settings_CellPadding}" Style="{StaticResource LabelText}" />
                    <TextBox Grid.Column="1" Text="{Binding CellPadding.Text, UpdateSourceTrigger=LostFocus}"
                             mvvm:Behaviors.CommitOnEnter="True"
                             mvvm:Behaviors.HasError="{Binding HasCellPaddingError}"
                             AutomationProperties.AutomationId="Settings.CellPadding"
                             AutomationProperties.Name="{l:Tr Settings_CellPadding}" />
                    <TextBlock Grid.Column="2" Text="{l:Tr Settings_CellPaddingHint}"
                               Style="{StaticResource MutedText}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding CellPaddingError}"
                               Style="{StaticResource ErrorText}" FontSize="11" Margin="0,3,0,0"
                               Visibility="{Binding CellPaddingError, Converter={StaticResource NullToCollapsed}}"
                               AutomationProperties.AutomationId="Settings.CellPaddingError" />
                </Grid>
            </StackPanel>
        </Border>

        <CheckBox Content="{l:Tr Settings_UseAsDefault}" IsChecked="{Binding UseAsDefault}" Margin="0,12,0,0"
                  IsEnabled="{Binding IsEditable}"
                  AutomationProperties.AutomationId="Settings.UseAsDefault"
                  ToolTip="{l:Tr Settings_UseAsDefaultTip}" />

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="{l:Tr Settings_RegenerateAll}" Command="{Binding RegenerateAllCommand}"
                    AutomationProperties.AutomationId="Settings.RegenerateAll"
                    ToolTip="{l:Tr Settings_RegenerateAllTip}" />
            <Button DockPanel.Dock="Right" Content="{l:Tr Common_Cancel}" IsCancel="True"
                    Margin="8,0,0,0" MinWidth="88" AutomationProperties.AutomationId="Settings.Cancel" />
            <Button DockPanel.Dock="Right" Content="{l:Tr Settings_Save}" Command="{Binding SaveCommand}" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="Settings.Save" />
        </DockPanel>
    </StackPanel>
</Window>
