<Project Sdk="WixToolset.Sdk/6.0.2">

  <!--
    GanttIt.Installer — produces GanttIt-<version>.msi (Windows only).

    Build, from the repo root on Windows:
      dotnet build GanttIt.sln -c "Release R26"
      dotnet build GanttIt.sln -c "Release R27"
      bash installer/stage.sh 2026
      bash installer/stage.sh 2027
      dotnet build installer/GanttIt.Installer.wixproj -c Release
    Output: installer/bin/Release/GanttIt-<version>.msi

    Not part of GanttIt.sln: the Linux CI jobs build the solution, and WiX MSI
    emission is Windows-only.

    SDK pinned to 6.x as in rst-c: the <Files> harvest element in Product.wxs
    needs WiX v5+ (v4 has no <Files> schema and fails with WIX0005).
  -->

  <!--
    Version. One property, GanttItVersion, carries the release tag into every
    build (see Directory.Build.props): the release pipeline passes
    -p:GanttItVersion=1.0.0-rc.1, push/PR builds pass it EMPTY, local builds
    omit it. Directory.Build.props derives the local $(Version) from it (a
    global property, even an empty one, cannot be reassigned by a
    PropertyGroup — the rst-c "effective version" trick), falling back to the
    dev version 0.0.0-dev.

    The MSI ProductVersion must be numeric, so it is the a.b.c part of
    $(Version) with any prerelease/build suffix stripped: 1.0.0-rc.1 -> 1.0.0,
    0.0.0-dev -> 0.0.0. It reaches Product.wxs as $(var.GanttItMsiVersion)
    through DefineConstants. The file name keeps the full version so release
    candidates and finals are distinguishable: GanttIt-1.0.0-rc.1.msi.
  -->
  <PropertyGroup>
    <GanttItMsiVersion>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^\d+\.\d+\.\d+').Value)</GanttItMsiVersion>
    <DefineConstants>$(DefineConstants);GanttItMsiVersion=$(GanttItMsiVersion)</DefineConstants>
    <OutputName>GanttIt-$(Version)</OutputName>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Configurations>Debug;Release</Configurations>
    <!-- The MSI ICE validation suite was authored for the per-machine
         install model; some of its rules fire on every per-user
         (Scope="perUser") harvest, a gap the WiX team acknowledges
         (wixtoolset/issues#8633). Combined with the repo-wide
         TreatWarningsAsErrors=true they would block the build:
           ICE91 — "directory doesn't vary based on ALLUSERS"; that is
                   the *intent* of perUser scope.
           ICE38 — components in the user profile "should" have an HKCU
                   KeyPath instead of a file KeyPath; auto-harvested
                   per-file components cannot express that. (The
                   folder-cleanup components in Product.wxs do use an HKCU
                   KeyPath.)
           ICE64 — every directory the package lays out in the user
                   profile must be listed in the RemoveFile table
                   (RemoveFolder), or it is left behind on uninstall.
                   Product.wxs lists the folders Gantt-It owns
                   (GanttIt\, Resources\, icons\ per year). It deliberately
                   does not list Autodesk\Revit\Addins\<year>\ and its
                   parents: Revit owns them and other add-ins live there,
                   so ICE64 still fires for those four directories.
           ICE61 — warns that MajorUpgrade/@AllowSameVersionUpgrades also
                   replaces an install of the same ProductVersion. That is
                   deliberate (Product.wxs): an rc and its final share the
                   numeric a.b.c, and must not end up side by side. -->
    <SuppressIces>ICE38;ICE91;ICE61</SuppressIces>
  </PropertyGroup>

  <!-- WixUI dialog set for the branded setup UI (WixUI_Minimal). The SDK
       registers referenced wixext packages as build extensions. Version is
       pinned centrally in Directory.Packages.props (Central Package
       Management: no Version here, NU1008). -->
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>

  <Target Name="GanttItCheckVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GanttItMsiVersion)' == ''"
           Text="GanttItVersion '$(Version)' does not start with a numeric a.b.c version." />
    <Error Condition="!Exists('stage\2026\GanttIt.addin') Or !Exists('stage\2027\GanttIt.addin')"
           Text="installer/stage/2026 and installer/stage/2027 must be staged first (installer/stage.sh)." />
    <Message Importance="high" Text="Gantt-It MSI: ProductVersion $(GanttItMsiVersion) (version $(Version)) -> $(OutputName).msi" />
  </Target>

</Project>
