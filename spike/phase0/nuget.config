<?xml version="1.0" encoding="utf-8"?>
<!-- Offline restore on the VM: the Nice3point reference packages are staged in .\packages
     next to this file (not committed; tools/vm/pack.py --pkg downloads them). -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="packages" />
    <!-- nuget.org is still needed: SDK 10 restores the net8 targeting packs
         (Microsoft.NETCore.App.Ref / WindowsDesktop.App.Ref 8.x) when building R26. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
